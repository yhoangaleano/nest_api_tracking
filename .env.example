# Application
NODE_ENV=development  # Options: development, production, test
PORT=3000

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=tracking_user
POSTGRES_PASSWORD=tracking_pass
POSTGRES_DATABASE=tracking_db
POSTGRES_SYNC=false  # true solo en desarrollo, NUNCA en producción

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TTL=3600  # 1 hora en segundos
REDIS_PASSWORD=  # vacío para desarrollo local, requerido en producción

# JWT Configuration (minimum 32 characters required)
# IMPORTANT: Generate new secrets for each environment using:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-here
JWT_EXPIRATION=1h  # Development: 1h, Production: 15m recommended
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-minimum-32-characters-long
JWT_REFRESH_EXPIRATION=7d  # Development: 7d, Production: 30d recommended

# Security
ALLOWED_ORIGINS=http://localhost:3001
