# API de NestJS
NODE_ENV=production
PORT=3000

# PostgreSQL (Production Database - RDS or managed service)
# TODO: Update with production PostgreSQL credentials
POSTGRES_HOST=your-rds-endpoint.amazonaws.com
POSTGRES_PORT=5432
POSTGRES_USER=tracking_user
POSTGRES_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>
POSTGRES_DATABASE=tracking_db
POSTGRES_SYNC=false  # NEVER true in production - use migrations instead

# Redis (Production Cache - ElastiCache or managed service)
# TODO: Update with production Redis credentials
REDIS_HOST=your-redis-endpoint.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>
REDIS_TTL=3600

